# ==========================================
# Database / Docker PostgreSQL
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/hamro_chalachitraghar_db
DB_NAME=hamro_chalachitraghar_db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ==========================================
# Spring Profile / Application
# ==========================================
SPRING_PROFILES_ACTIVE=dev
APP_TIME_ZONE=Asia/Kathmandu
APP_VERSION=local
MANAGEMENT_ENDPOINTS_EXPOSED=health,info,prometheus
HEALTH_SHOW_DETAILS=never
HEALTH_PROBES_ENABLED=true
GRACEFUL_SHUTDOWN_TIMEOUT=30s

# Refund processing is manual-first. Auto processing is off and no eSewa refund API is assumed.
REFUND_PROCESSING_ENABLED=true
REFUND_AUTO_PROCESS_ENABLED=false
REFUND_DEFAULT_METHOD=MANUAL
REFUND_MAX_ATTEMPTS=3
REFUND_INITIAL_RETRY_DELAY=PT1M
REFUND_RETRY_MULTIPLIER=2.0
REFUND_MAX_RETRY_DELAY=PT1H
REFUND_RETRY_BATCH_SIZE=50
REFUND_RETRY_INTERVAL=PT1M
REFUND_PROCESSING_TIMEOUT=PT5M
REFUND_CLAIM_BATCH_SIZE=50
REFUND_WORKER_ID=refund-worker
REFUND_REPORTS_MAX_RANGE_DAYS=366
REFUND_REPORTS_DEFAULT_BUCKET=DAY
REFUND_CONSISTENCY_ENABLED=true
REFUND_CONSISTENCY_BATCH_SIZE=100
REFUND_RETENTION_ENABLED=false
REFUND_RETENTION_MODE=ANONYMIZE
REFUND_RETENTION_REFUND_DAYS=2555
REFUND_RETENTION_ATTEMPT_DAYS=2555
REFUND_RETENTION_BATCH_SIZE=100
REFUND_RETENTION_INTERVAL=PT24H

# ==========================================
# Audit Configuration
# ==========================================
AUDIT_EXPORT_ENABLED=true
AUDIT_EXPORT_MAX_ROWS=10000
AUDIT_EXPORT_MAX_RANGE_DAYS=31
AUDIT_RETENTION_ENABLED=false
AUDIT_RETENTION_MODE=ANONYMIZE
AUDIT_RETENTION_DEFAULT_DAYS=365
AUDIT_RETENTION_SECURITY_DAYS=730
AUDIT_RETENTION_PAYMENT_DAYS=730
AUDIT_RETENTION_HIGH_SEVERITY_DAYS=730
AUDIT_RETENTION_BATCH_SIZE=100
AUDIT_RETENTION_INTERVAL=PT24H
AUDIT_REPORTS_MAX_RANGE_DAYS=31
AUDIT_REPORTS_DEFAULT_BUCKET=DAY
AUDIT_INTEGRITY_ENABLED=true
AUDIT_INTEGRITY_BATCH_SIZE=500
AUDIT_INTEGRITY_INTERVAL=PT24H

# ==========================================
# JWT / CORS Security
# ==========================================
JWT_SECRET=replace_with_at_least_32_characters_secret
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:4200

